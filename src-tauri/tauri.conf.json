{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RT-PN",
  "version": "0.1.0",
  "identifier": "com.kevindadi.rtpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RT-PN  ·  Real-Time Petri Workbench",
        "width": 1540,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Real-time Petri net analysis workbench"
  }
}
